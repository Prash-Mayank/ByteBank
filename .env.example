# Copy this file to .env and fill in real values.
# .env must NEVER be committed — it is already in .gitignore.

# MySQL root password for the bytebank-db container
DB_PASSWORD=your_db_password

# 256-bit secret used to sign and verify JWTs
JWT_SECRET=your_256bit_secret

# Gmail account used for SMTP (OTP and transaction alerts)
MAIL_USERNAME=your@gmail.com
# Gmail APP password — not your normal account password
MAIL_PASSWORD=app_password_here

# Razorpay free test-mode credentials (no credit card required)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Google Gemini free-tier API key from https://aistudio.google.com
GEMINI_API_KEY=AIzaSy...

# Internal Docker URL for the Ollama container (leave as-is for Docker Compose)
OLLAMA_BASE_URL=http://bytebank-ai:11434
